#!/bin/sh
# clip: clipboard wrapper.
# SSH/WSL/container → OSC 52 (copy only); macOS → pbcopy/pbpaste; else → xclip.

set -eu

is_remote() {
    if [ -n "${SSH_CONNECTION:-}" ] \
       || [ -n "${SSH_TTY:-}" ] \
       || [ -n "${SSH_CLIENT:-}" ] \
       || [ -n "${WSL_DISTRO_NAME:-}" ] \
       || [ -n "${container:-}" ] \
       || [ -e /.dockerenv ] \
       || [ -e /run/.containerenv ]; then
        return 0
    fi
    return 1
}

# OSC 52 asks the local terminal emulator to set its clipboard, so it works
# through SSH, WSL and `docker exec` with nothing listening on either end.
# Written to /dev/tty so it reaches the terminal even when stdout is a pipe
# (lazygit runs `clip copy` as a subprocess).
osc52_copy() {
    b64=$(base64 | tr -d '\n')
    printf '\033]52;c;%s\a' "$b64" > /dev/tty
}

do_copy() {
    if is_remote; then
        osc52_copy
    elif [ "$(uname -s)" = Darwin ]; then
        pbcopy
    elif command -v xclip >/dev/null 2>&1; then
        xclip -selection clipboard -i
    else
        echo "clip: no clipboard backend available" >&2
        exit 1
    fi
}

do_paste() {
    if is_remote; then
        # OSC 52 reads are denied or prompted by most terminals; don't rely on them.
        echo "clip: paste is not available in a remote session; use the terminal's paste" >&2
        exit 1
    elif [ "$(uname -s)" = Darwin ]; then
        pbpaste
    elif command -v xclip >/dev/null 2>&1; then
        xclip -selection clipboard -o
    else
        echo "clip: no clipboard backend available" >&2
        exit 1
    fi
}

cmd=${1:-}
[ -n "$cmd" ] || { echo "usage: clip copy [TEXT] | clip paste" >&2; exit 2; }
shift

case "$cmd" in
    copy)
        if [ $# -gt 0 ]; then
            printf %s "$*" | do_copy
        else
            do_copy
        fi
        ;;
    paste)
        do_paste
        ;;
    *)
        echo "clip: unknown subcommand '$cmd'" >&2
        exit 2
        ;;
esac
