font-family = "FiraMono Nerd Font"
font-size = 24

keybind = cmd+up=unbind
keybind = cmd+left=unbind
keybind = cmd+right=unbind
keybind = cmd+down=unbind

# herdr comes from mise; the shim path is stable across versions and platforms.
command = {{ joinPath .chezmoi.homeDir ".local/share/mise/shims/herdr" }}
